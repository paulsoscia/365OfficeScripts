
    // Line Excel Macro/Script 365 Office Scripts ( TypeScript )
    // Office Scripts in Microsoft 365 are written in TypeScript, 
    //  which is a superset of JavaScript. When you save an Office Script, 
    // it is stored with the file extension .osts. 
    // These files are typically found in your OneDrive, within the /Documents/Office Scripts/ folder. 

    let selectedSheet = workbook.getActiveWorksheet();

    let m = 1;
    let b = 2;
    let X = "";

    selectedSheet.getRange("F2:F3").setValues([["m="], ["b="]]);
    // Define Name m on workbook range G2 on selectedSheet
    workbook.addNamedItem("m", selectedSheet.getRange("G2"), "");
    // Define Name b on workbook range G3 on selectedSheet
    workbook.addNamedItem("b", selectedSheet.getRange("G3"), "");
    selectedSheet.getRange("G2").setValue(m);
    selectedSheet.getRange("G3").setValue(b);

    for (let iColumn = 0; iColumn <= 2; iColumn++) {
        for (let iRow = 0; iRow <= 10; iRow++) {
            let cellFormula2: string = selectedSheet.getCell(iRow, iColumn).getFormula();

            if (cellFormula2.length > 0)
                cellFormula2 = cellFormula2.replace("{", "");
            if (cellFormula2.length > 0)
                cellFormula2 = cellFormula2.replace("}", "");

            if (iRow == 0 && iColumn == 0) {
                selectedSheet.getCell(iRow, iColumn).setValue("X");
                X = String.fromCharCode("A".charCodeAt(0) + iColumn);
            }
            else if (iRow == 0 && iColumn == 1) {
                selectedSheet.getCell(iRow, iColumn).setValue("Y");
            }
            else if (iRow > 0 && iColumn == 0) {
                // X
                selectedSheet.getCell(iRow, iColumn).setValue(iRow-1);
            }
            else if (iRow > 0 && iColumn == 1) {
                //selectedSheet.getCell(iRow, iColumn).setValue(m*iRow+b);
                // Y = mx + b
                selectedSheet.getCell(iRow, iColumn).setFormula("=m*" + X  + (iRow + 1) + "+b");
            }
            else {
                let sCellRow = String.fromCharCode("A".charCodeAt(0) + (iColumn )) + (iRow+1);
                selectedSheet.getCell(iRow, iColumn).setValue(sCellRow );
            }
        }

    }

    // Format
	// Set font bold to true for range A1:B1 on selectedSheet
	selectedSheet.getRange("A1:B1").getFormat().getFont().setBold(true);
	// Set horizontal alignment to ExcelScript.HorizontalAlignment.center for range A1:B1 on selectedSheet
	selectedSheet.getRange("A1:B1").getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);
	//selectedSheet.getRange("A1:B1").getFormat().setIndentLevel(0);
	// Indent set to 0 for range A1:B1 on selectedSheet
	//selectedSheet.getRange("A1:B1").getFormat().setIndentLevel(0);
	// Set fill color to #E8E8E8 for range A1:B1 on selectedSheet
	selectedSheet.getRange("A1:B1").getFormat().getFill().setColor("#E8E8E8");

    // Chart/Graph
    let chart_1 = selectedSheet.addChart(ExcelScript.ChartType.xyscatterLines, selectedSheet.getRange("A1:B11"));

	// Solutions
	// Set range F5:G6 on selectedSheet
	selectedSheet.getRange("F5:G6").setFormulas([["rise over run","=(B3-B2)/(A3-A2)"],["solve for b","=m*A2+b"]]);
	// Set width of column(s) at range F:F on selectedSheet to 60.6
	selectedSheet.getRange("F:F").getFormat().setColumnWidth(60.6);
	// Set font bold to true for range F2:F6 on selectedSheet
	selectedSheet.getRange("F2:F6").getFormat().getFont().setBold(true);
	// Set fill color to #E8E8E8 for range F2:F6 on selectedSheet
	selectedSheet.getRange("F2:F6").getFormat().getFill().setColor("#E8E8E8");


